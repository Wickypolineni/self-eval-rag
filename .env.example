# OpenRouter — one key, one bill, all models.
# Get yours at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Generator and evaluator are DIFFERENT VENDORS on purpose.
# A model grades a stranger's prose more harshly than its own.
GENERATOR_MODEL=google/gemini-2.5-flash
EVALUATOR_MODEL=openai/gpt-5-mini

# Cheaper pair for development iteration (~1c/run vs ~6c/run):
#   GENERATOR_MODEL=meta-llama/llama-3.3-70b-instruct
#   EVALUATOR_MODEL=google/gemini-2.5-flash-lite

# The loop must always terminate. 2 retries = 3 generations maximum.
MAX_RETRIES=2
